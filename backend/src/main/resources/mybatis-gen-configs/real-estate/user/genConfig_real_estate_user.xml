<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "https://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>
    <properties url="file:src/main/resources/mybatis-gen-configs/real-estate/generator.properties"/>

    <context id="RealEstateDynamicSqlMapper" targetRuntime="MyBatis3DynamicSql">
        <property name="javaFileEncoding" value="UTF-8"/>
        <property name="autoDelimitKeywords" value="true"/>
        <property name="beginningDelimiter" value="`"/>
        <property name="endingDelimiter" value="`"/>

        <plugin type="org.mybatis.generator.plugins.UnmergeableXmlMappersPlugin"/>
        <plugin type="org.mybatis.generator.plugins.MapperAnnotationPlugin"/>

        <commentGenerator>
            <property name="suppressDate" value="true"/>
            <property name="suppressAllComments" value="true"/>
        </commentGenerator>

        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="${mbg.jdbc.url}"
                        userId="${mbg.jdbc.username}"
                        password="${mbg.jdbc.password}"/>

        <javaTypeResolver>
            <property name="forceBigDecimals" value="false"/>
            <property name="useJSR310Types" value="true"/>
        </javaTypeResolver>

        <javaModelGenerator targetPackage="kr.co.realestate.domain.user.generated.model"
                            targetProject="src/main/java">
            <property name="trimStrings" value="true"/>
        </javaModelGenerator>

        <javaClientGenerator targetPackage="kr.co.realestate.domain.user.generated.mapper"
                             targetProject="src/main/java">
            <property name="dynamicSqlSupportPackage" value="kr.co.realestate.domain.user.generated.support"/>
        </javaClientGenerator>

        <table tableName="users" domainObjectName="User" mapperName="UserMapper">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
            <columnOverride column="enabled" javaType="java.lang.Boolean"/>
        </table>

        <table tableName="roles" domainObjectName="Role" mapperName="RoleMapper">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>

        <table tableName="user_roles" domainObjectName="UserRole" mapperName="UserRoleMapper">
            <ignoreColumn column="created_at"/>
            <ignoreColumn column="updated_at"/>
            <ignoreColumn column="created_by"/>
            <ignoreColumn column="updated_by"/>
        </table>
    </context>
</generatorConfiguration>
