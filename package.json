{
  "name": "real-estate-monorepo",
  "private": true,
  "scripts": {
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:lint": "npm --prefix frontend run lint",
    "frontend:test": "npm --prefix frontend run test",
    "backend": "gradle -p backend bootRun",
    "backend:local": "test -f backend/src/main/resources/application-local.yml || cp backend/src/main/resources/application-local.yml.example backend/src/main/resources/application-local.yml; gradle -p backend bootRun",
    "backend:build": "gradle -p backend build",
    "backend:test": "gradle -p backend test",
    "build": "npm run frontend:build && npm run backend:build",
    "test": "npm run frontend:test && npm run backend:test"
  }
}