# ── 개발 서버 기본값 ─────────────────────────────────────────
PUBLIC_URL=http://localhost:5173
API_BASE_URL=https://real-estate-dev.duckdns.org

# ── Host port 매핑 ───────────────────────────────────────────
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173

# ── MySQL ───────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=real_estate_db
MYSQL_USER=real_estate
MYSQL_PASSWORD=password

# ── Backend ─────────────────────────────────────────────────
JWT_SECRET=local-dev-secret-must-be-at-least-32-characters-long
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://real-estate-dev.duckdns.org:5173,https://real-estate-devs.vercel.app

# ── 선택: DuckDNS로 개발 서버를 외부에서 접근할 때만 사용 ─────
DUCKDNS_DOMAIN=real-estate-dev.duckdns.org
DUCKDNS_TOKEN=

# ── Vercel 프론트 배포 기준 ──────────────────────────────────
# Vercel/GitHub Actions에는 Caddy가 처리하는 HTTPS DuckDNS backend origin을 등록한다.
VERCEL_API_BASE_URL=https://real-estate-dev.duckdns.org